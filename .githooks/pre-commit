#!/bin/sh
# If this commit touches a published page or a student notebook, rebuild the notebook text pages and
# the search index and add them to the same commit, so search never lags behind the site.
# Install once per clone:  git config core.hooksPath .githooks
staged="$(git diff --cached --name-only)"
if echo "$staged" | grep -E '\.ipynb$' | grep -qE '^(notebooks|materials)/'; then
  python3 build/build_notebook_text.py || exit 1
  git add -A docs/notebook-text
fi
if git diff --cached --name-only | grep -E '^docs/.*\.html$' | grep -qv '^docs/pagefind/'; then
  sh .githooks/build-search-index.sh || exit 1
  git add -A docs/pagefind
fi
